# CareerPilot local development example.
# Copy this file to .env locally and fill values on your own machine.
# Do not commit real credentials, server addresses, user data, or paid API keys.

CAREERPILOT_ENV=local
CAREERPILOT_API_HOST=127.0.0.1
CAREERPILOT_API_PORT=8000

# Local-only placeholder. Production should use Alibaba Cloud RDS MySQL/PostgreSQL.
DATABASE_URL=sqlite:///local-dev-only.db

# Object storage boundary placeholder. Production should use OSS or compatible object storage.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=

# Paid model/API provider placeholders. Leave blank unless explicitly configured outside git.
MODEL_PROVIDER=
MODEL_API_BASE=
MODEL_API_KEY=
